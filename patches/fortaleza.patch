+// Adicionalidade matrix sorting
+(function(){
+  const valMap = {'Alto':3, 'Médio':2, 'Baixo':1};
+  document.querySelectorAll('table.adic-sortable').forEach(tbl => {
+    let curCol = -1, curDir = 0;
+    const ths = tbl.querySelectorAll('thead th.sortable');
+    ths.forEach(th => {
+      th.addEventListener('click', function(){
+        const col = parseInt(this.dataset.adicCol);
+        if(curCol === col) curDir = -curDir;
+        else { curCol = col; curDir = col === 0 ? 1 : -1; }
+        const tbody = tbl.querySelector('tbody');
+        const rows = Array.from(tbody.querySelectorAll('tr'));
+        rows.sort((a,b) => {
+          const cellA = a.cells[col];
+          const cellB = b.cells[col];
+          let va, vb;
+          if(col === 0) {
+            va = cellA.textContent.trim().toLowerCase();
+            vb = cellB.textContent.trim().toLowerCase();
+            return curDir === 1 ? va.localeCompare(vb,'pt-BR') : vb.localeCompare(va,'pt-BR');
+          } else {
+            va = valMap[cellA.textContent.trim()] || 0;
+            vb = valMap[cellB.textContent.trim()] || 0;
+            return curDir === -1 ? vb - va : va - vb;
+          }
+        });
+        rows.forEach(r => tbody.appendChild(r));
+        ths.forEach(h => { h.classList.remove('sort-asc','sort-desc'); h.querySelector('.sort-icon').textContent = '↕'; });
+        this.classList.add(curDir === -1 ? 'sort-desc' : 'sort-asc');
+        this.querySelector('.sort-icon').textContent = curDir === -1 ? '↓' : '↑';
+      });
+    });
+  });
+})();
 </script>
